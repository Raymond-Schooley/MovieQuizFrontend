# Copy to .env.local and adjust if you need to override defaults.

# Only needed if you're running `npm run dev` WITHOUT the nginx reverse
# proxy in front and want it to hit a backend that isn't on localhost:8080.
# VITE_DEV_API_PROXY_TARGET=http://localhost:8080

# Only needed if you want the built app to call an API on a different
# origin than the one it's served from (breaks the same-origin/no-CORS
# setup the reverse proxy gives you, so leave this unset unless you have
# a specific reason).
# VITE_API_BASE_URL=/api/v1
